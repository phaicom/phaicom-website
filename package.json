{
  "name": "phaicom-website",
  "version": "2.0.0",
  "private": true,
  "description": "Phaicom's Personal Website",
  "license": "BSD-3-Clause",
  "author": "Reawpai Chunsoi <reawpai.chunsoi@gmail.com>",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "optimize:images": "nr scripts/convert-to-webp.ts",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/ni": "^30.5.0",
    "@types/bun": "^1.4.2",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.10.12"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx,json}": [
      "nr lint",
      "nr lint:fix",
      "nr fmt"
    ]
  },
  "packageManager": "bun@1.4.2"
}
